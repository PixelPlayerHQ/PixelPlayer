    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Bem-vindo ao PixelPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Você está usando uma versão beta que pode conter bugs, travamentos ou recursos experimentais. Ajude-nos a melhorar reportando problemas.</string>
    <string name="beta_sheet_expect_title">O que esperar</string>
    <string name="beta_sheet_expect_1">Bugs, travamentos ou recursos incompletos podem ocorrer inesperadamente.</string>
    <string name="beta_sheet_expect_2">Alguns recursos podem mudar ou ser removidos sem aviso.</string>
    <string name="beta_sheet_expect_3">As versões beta podem ser mais instáveis que as versões oficiais.</string>
    <string name="beta_sheet_expect_4">Sempre verifique se há atualizações antes de reportar um problema conhecido.</string>
    <string name="beta_sheet_expect_summary">O que as versões beta podem alterar, quebrar ou melhorar durante os testes.</string>
    <string name="beta_sheet_github_title">Atalho para issue no GitHub</string>
    <string name="beta_sheet_github_body">Pesquise primeiro e depois abra um relatório focado para bugs, travamentos, solicitações ou dúvidas.</string>
    <string name="beta_sheet_open_issues">Abrir issues existentes</string>
    <string name="beta_sheet_report_bug">Reportar problema ou travamento</string>
    <string name="beta_sheet_report_body">Compartilhe os passos para reproduzir, o resultado esperado, o resultado real e os detalhes do seu dispositivo/sistema.</string>
    <string name="beta_sheet_report_title">Como reportar</string>
    <string name="beta_sheet_report_summary">Uma rápida lista de verificação antes de abrir uma nova issue.</string>
    <string name="beta_sheet_before_title">Antes de abrir uma issue</string>
    <string name="beta_sheet_before_1">Pesquise issues abertas e fechadas existentes para evitar duplicatas.</string>
    <string name="beta_sheet_before_2">Atualize para a versão mais recente do PixelPlayer e confirme que o problema ainda acontece.</string>
    <string name="beta_sheet_before_3">Reinicie o aplicativo e confirme que o problema persiste.</string>
    <string name="beta_sheet_before_4">Tente reproduzi-lo e anote os passos exatos.</string>
    <string name="beta_sheet_issue_type_title">Qual tipo de issue?</string>
    <string name="beta_sheet_issue_type_bug">Relatório de bug: algo se comporta incorretamente.</string>
    <string name="beta_sheet_issue_type_feature">Solicitação de recurso: adicionar um novo recurso ou melhoria.</string>
    <string name="beta_sheet_issue_type_question">Dúvida: use as Discussões, se habilitadas, ou abra uma issue com o rótulo de pergunta.</string>
