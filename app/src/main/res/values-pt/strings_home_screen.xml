    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">Boas-vindas ao PixelPlayer 0.7.5-beta</string>
    <string name="beta_sheet_welcome_body">Você está usando uma versão beta que pode conter erros, falhas ou recursos experimentais. Ajude-nos a melhorar relatando problemas.</string>
    <string name="beta_sheet_expect_title">O que esperar</string>
    <string name="beta_sheet_expect_1">Bugs, falhas ou recursos incompletos podem ocorrer inesperadamente.</string>
    <string name="beta_sheet_expect_2">Alguns recursos podem mudar ou ser removidos sem aviso prévio.</string>
    <string name="beta_sheet_expect_3">Versões beta podem ser mais instáveis do que as versões finais.</string>
    <string name="beta_sheet_expect_4">Sempre verifique se há atualizações antes de relatar um problema conhecido.</string>
    <string name="beta_sheet_expect_summary">O que as versões beta podem alterar, quebrar ou melhorar durante os testes.</string>
    <string name="beta_sheet_github_title">Atalho de issues no GitHub</string>
    <string name="beta_sheet_github_body">Pesquise primeiro e, em seguida, abra um relatório focado para bugs, falhas, solicitações ou dúvidas.</string>
    <string name="beta_sheet_open_issues">Abrir issues existentes</string>
    <string name="beta_sheet_report_bug">Relatar problema ou falha</string>
    <string name="beta_sheet_report_body">Compartilhe o passo a passo para reproduzir, os resultados esperados, os resultados reais e os detalhes do seu dispositivo/sistema operacional.</string>
    <string name="beta_sheet_report_title">Como relatar</string>
    <string name="beta_sheet_report_summary">Uma lista de verificação rápida antes de abrir uma nova issue.</string>
    <string name="beta_sheet_before_title">Antes de abrir uma issue</string>
    <string name="beta_sheet_before_1">Pesquise issues abertas e fechadas para evitar duplicatas.</string>
    <string name="beta_sheet_before_2">Atualize para a versão mais recente do PixelPlayer e confirme se o problema ainda ocorre.</string>
    <string name="beta_sheet_before_3">Reinicie o aplicativo e confirme se o problema persiste.</string>
    <string name="beta_sheet_before_4">Tente reproduzir o problema e anote os passos exatos.</string>
    <string name="beta_sheet_issue_type_title">Qual o tipo de issue?</string>
    <string name="beta_sheet_issue_type_bug">Relatório de bug: Algo se comporta de maneira incorreta.</string>
    <string name="beta_sheet_issue_type_feature">Solicitação de recurso: Adicionar um novo recurso ou melhoria.</string>
    <string name="beta_sheet_issue_type_question">Dúvida: Use Discussions se estiver ativado ou abra uma issue com a etiqueta de dúvida.</string>
