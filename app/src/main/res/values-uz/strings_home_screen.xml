    <string name="beta_sheet_feature_title">Xususiyat sörovi</string>
    <string name="beta_sheet_feature_summary">Yangi xususiyat yoki yaxşilaşni xohlasangiz, uşbu maydonlardan nusxa oling.</string>
    <string name="beta_sheet_feature_problem">Muammo bayoni: Qanday muammoni hal qilişga uringyapsiz?</string>
    <string name="beta_sheet_feature_solution">Taklif qilingan yeçim: U qanday işlaşi kerak?</string>
    <string name="beta_sheet_feature_alternatives">Körib çiqilgan muqobillar: Başqa yondaşuvlar bormi?</string>
    <string name="beta_sheet_feature_scope">Qamrov: Qaysi ekranlar yoki oqimlarga taʼsir qiladi?</string>
    <string name="beta_sheet_feature_mockup">Maket yoki havola rasmi, agar mavjud bölsa.</string>
    <string name="beta_sheet_quality_title">Sarlavhalar, maxfiylik va qamrov</string>
    <string name="beta_sheet_quality_summary">Hisobotni saralaş oson va ulaşiş uçun xavfsiz qiling.</string>
    <string name="beta_sheet_title_examples_title">Yaxşi muammo sarlavhalari</string>
    <string name="beta_sheet_title_example_1">Ekvalayzer: Oldindan örnatilgan yorliqlarni almashtirişda indikator siljiydi</string>
    <string name="beta_sheet_title_example_2">Qidiruv: Böş sörov uçun tarix röyxati paydo bölmaydi</string>
    <string name="beta_sheet_title_example_3">Xususiyat: \"Yaqinda qöşilganlar\" pleylistini saralaş tanlovini qöşiş</string>
    <string name="beta_sheet_avoid_title">Iltimos, çetlab öting</string>
    <string name="beta_sheet_avoid_1">\"U işlamayapti\" kabi umumiy hisobotlar.</string>
    <string name="beta_sheet_avoid_2">Bitta muammoda bir-biriga boğliq bölmagan bir neçta muammolar.</string>
    <string name="beta_sheet_avoid_3">Tahrirlanmagan jurnallar yoki şaxsiy maʼlumotlarga ega skrinşotlar.</string>
    <string name="beta_sheet_privacy_title">Maxfiylik eslatmasi</string>
    <string name="beta_sheet_privacy_body">Jurnallar, skrinşotlar yoki videolarni joylaşdan oldin şaxsiy yoki maxfiy maʼlumotlarni olib taşlang.</string>
    <string name="beta_sheet_nightly_title">Tungi yığilmalar</string>
    <string name="beta_sheet_nightly_summary">Tungi versiyalar relizlardan qanday farq qiladi va ular buzulganida nimalarni kiritiş kerak.</string>
    <string name="beta_sheet_nightly_body">Tungi versiyalar eng sönggi kommitlardan yaratiladi va tugallanmagan özgarişlar, vaqtincahlik xatolar yoki regressiyalarni öz içiga olişi mumkin. Ular rasmiy relizlardan köra tajribaviyroqdir.</string>
    <string name="beta_sheet_nightly_access">Ularga, agar mavjud bölsa, repozitoriydagi GitHub Actions oqimi artefaktlaridan kiring.</string>
    <string name="beta_sheet_nightly_report_title">Tungi muammolar haqida xabar beriş</string>
    <string name="beta_sheet_nightly_report_body">Tungi versiyadagi muammo haqida xabar berayotganda, doimo bu rasmiy relizda emas, tungi versiyada yuz berganini taʼkidlang. Imkon qadar yığilma sanasini, oqimning ijro nomini yoki raqamini yoki SHA kommitini kiriting. Şuningdek, ayni muammo eng sönggi rasmiy relizda yuz beriş-bermasligini tekşiring.</string>
    <string name="beta05_title">Beta 0.5.0 yangilanişi</string>
    <string name="beta05_clean_install_title">Toza örnatiş tavsiya etiladi</string>
    <string name="beta05_clean_install_body">Agar siz beta 0.5.0 dan ötayotgan bölsangiz, uşbu yangilanişga eski keşlangan holat örniga yangi kutubxona maʼlumotlari kerak bölişi mumkin.</string>
    <string name="beta05_if_wrong_meta_title">Agar metamaʼlumotlar yoki kutubxona yozuvlari notöğri körinsa</string>
    <string name="beta05_if_wrong_meta_body">Notöğri qöşiq metamaʼlumotlari, mos kelmaydigan ijroçilar yoki albomlar, yoki takrorlanayotgandek körinadigan yozuvlar odatda toza örnatiş muammoni hal qilişini anglatadi.</string>
    <string name="beta05_dont_show">Boşqa körsatilmasin</string>
    <string name="beta05_got_it">Tüşunarli</string>

