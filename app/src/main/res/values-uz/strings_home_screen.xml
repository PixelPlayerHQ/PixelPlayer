    <!-- BetaInfoBottomSheet -->
    <string name="beta_sheet_version">Beta 0.7.5</string>
    <string name="beta_sheet_letter">β</string>
    <string name="beta_sheet_welcome_title">PixelPlayer 0.7.5-beta versiyasiga xuş kelibsiz</string>
    <string name="beta_sheet_welcome_body">Siz xatolar, uzilişlar yoki tajribaviy xususiyatlar bölişi mumkin bölgan beta versiyadan foydalanyapsiz. Muammolar haqida xabar berib, uni yaxşilaşga yordam bering.</string>
    <string name="beta_sheet_expect_title">Nimalar kutilyapti</string>
    <string name="beta_sheet_expect_1">Xatolar, uzilişlar yoki çala xususiyatlar kutilmaganda yuz berişi mumkin.</string>
    <string name="beta_sheet_expect_2">Baʼzi xususiyatlar ogohlantirişsiz özgartirilişi yoki olib taşlanişi mumkin.</string>
    <string name="beta_sheet_expect_3">Beta versiyalar reliz versiyalariga qarağanda beqarorroq bölişi mumkin.</string>
    <string name="beta_sheet_expect_4">Maʼlum muammo haqida xabar berişdan oldin doim yangilanişlarni tekşiring.</string>
    <string name="beta_sheet_expect_summary">Test qiliş davomida beta versiyalar nimalarni özgartirişi, buzişi yoki yaxşilaşi mumkin.</string>
    <string name="beta_sheet_github_title">GitHub muammolariga tezkor ötiş</string>
    <string name="beta_sheet_github_body">Avval qidiring, söngra xatolar, uzilişlar, sörovlar yoki savollar uçun aniq hisobot oçing.</string>
    <string name="beta_sheet_open_issues">Mavjud muammolarni oçiş</string>
    <string name="beta_sheet_report_bug">Muammo yoki uziliş haqida xabar beriş</string>
    <string name="beta_sheet_report_body">Takrorlaş qadamlari, kutilgan natijalar, amaldagi natijalar va qurilmangiz/OT tafsilotlari bilan ulaşing.</string>
    <string name="beta_sheet_report_title">Qanday xabar beriladi</string>
    <string name="beta_sheet_report_summary">Yangi muammo oçişdan oldingi qisqa tekşiruv röyxati.</string>
    <string name="beta_sheet_before_title">Muammo oçişdan oldin</string>
    <string name="beta_sheet_before_1">Takrorlanişlarning oldini oliş uçun oçiq va yopiq muammolarni qidiring.</string>
    <string name="beta_sheet_before_2">Eng sönggi PixelPlayer versiyasiga yangilang va muammo hali ham mavjudligini tasdiqlang.</string>
    <string name="beta_sheet_before_3">Ilovani qayta işga tuşiring va muammo saqlanib qolayotganini tasdiqlang.</string>
    <string name="beta_sheet_before_4">Uni takrorlaşga urinib köring va aniq qadamlarni yozib oling.</string>
    <string name="beta_sheet_issue_type_title">Qaysi muammo turi?</string>
    <string name="beta_sheet_issue_type_bug">Xato hisoboti: Nimadir notöğri işlayapti.</string>
    <string name="beta_sheet_issue_type_feature">Xususiyat sörovi: Yangi xususiyat yoki yaxşilaş qöşiş.</string>
    <string name="beta_sheet_issue_type_question">Savol: Agar yozilgan bölsa, Munozaralardan foydalaning yoki savol yorliği bilan muammo oçing.</string>
    <string name="beta_sheet_bug_title">Xato hisoboti</string>
    <string name="beta_sheet_bug_summary_text">Nimadir notöğri işlasa yoki uziliş yuz bersa, uşbu maydonlardan nusxa oling.</string>
